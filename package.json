{
    "name": "ttpg-darrell",
    "version": "1.2.3",
    "description": "TTPG TypeScript library",
    "main": "dist/index.cjs",
    "files": [
        "dist"
    ],
    "scripts": {
        "check:prettier": "prettier --check .",
        "test": "jest",
        "index": "yarn cti ./src -i '*.test.ts' -i '*.testp.ts' -e jest-util -e lib-ext && find . -name 'index.ts.bak' -exec rm {} \\;",
        "index-ext": "yarn cti ./src/lib-ext -i '*.test.ts' -i '*.testp.ts' -e jest-util -e lib && find . -name 'index.ts.bak' -exec rm {} \\;",
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf build",
        "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts --debug src",
        "prepublishOnly": "yarn index && yarn index-ext && yarn build && yarn tsdown",
        "watch": "tsc -w -p tsconfig.json"
    },
    "author": "Darrell",
    "license": "Unlicense",
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^29.5.10",
        "@types/klaw-sync": "^6.0.5",
        "@types/node": "^20.10.0",
        "@types/yargs": "^17.0.32",
        "@typescript-eslint/eslint-plugin": "^6.20.0",
        "@typescript-eslint/parser": "^6.20.0",
        "create-ts-index": "^1.14.0",
        "eslint": "^8.56.0",
        "fs-extra": "^11.2.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jimp": "^0.22.12",
        "klaw-sync": "^6.0.0",
        "monotone-chain-convex-hull": "^1.1.0",
        "node": "^24.0.0",
        "prettier": "^3.1.1",
        "sharp": "^0.33.2",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "tsdown": "^0.23.0",
        "ttpg-mock": "^1.0.7",
        "typescript": "^5.3.2"
    },
    "dependencies": {
        "@tabletop-playground/api": "0.41.0",
        "fastest-levenshtein": "^1.0.16",
        "js-base64": "^3.7.7",
        "zod": "3.22.4"
    }
}
